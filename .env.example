# 复制为 .env 后按需修改。.env 已在 .gitignore 里，永远不要提交。
#
# 三档用法，按手头资源选一档：
#   1) 什么都没有：MOCK_MODE=1        —— 不联网，入库/检索/生成/引用校验全链路可跑
#   2) 有国内 API 免费额度：填 EMBED_* / LLM_*（必要时 RERANK_*），MOCK_MODE=0
#   3) 只在第六周部署：前两档都不影响，改 DATABASE_URL 即可换 Postgres

# ---------------- 存储 ----------------
# 默认 SQLite 单文件，不需要 Postgres。换 pgvector 时改成：
#   DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/kb
DATABASE_URL=sqlite:///./data/kb.db
# 向量块数超过这个值会打印警告，提示该换索引
VECTOR_WARN_CHUNKS=50000

# ---------------- 假模型（无 key / CI） ----------------
# 1 = 向量、重排、对话全部用本地桩实现：不联网、不要 key，但输出质量不作承诺
MOCK_MODE=0

# ---------------- 向量接口（OpenAI 兼容 /embeddings） ----------------
# 常用：硅基流动 / 智谱 / 阿里百炼 的 BAAI/bge-m3 等，都有免费额度
# base_url 填到 /v1 即可（自动拼 /embeddings），也可以直接填完整地址
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 维度必须与接口实际返回一致，否则报错（避免把不同模型的向量混进一个矩阵）
EMBED_DIM=512
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT_SECONDS=30
EMBED_MAX_RETRIES=2
# 本地 bge 模型需要检索指令前缀；接口模型（如 bge-m3）留空
EMBED_QUERY_INSTRUCTION=
# 文本→向量的本地缓存，同一文本只发一次网络请求
EMBED_CACHE_ENABLED=true

# ---------------- 重排接口（/rerank） ----------------
# 默认关闭：融合结果已经够用，开启会多一次网络往返
RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
# 只重排融合后的前 N 个候选
RERANK_CANDIDATES=10
RERANK_TIMEOUT_SECONDS=30

# ---------------- 检索层 ----------------
# jieba 自定义词典（设备型号 + 专业术语）
BM25_DICT_PATH=data/dict.txt
# 融合前每一路的候选数量，以及 RRF 平滑常数 k
RETRIEVAL_CANDIDATES=50
RRF_K=60

# ---------------- 对话接口（P3） ----------------
# 三项任一为空时 /api/chat 返回 config_missing 结构化错误，不发起请求
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 单次调用超时（秒），连接/读取/整体截止共用
LLM_TIMEOUT_SECONDS=30
# 失败重试次数与指数退避基数（秒）：首发失败后等 1s、2s 再试；已输出 token 则不重试
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
# 工业问答不需要发散，温度压低；长度上限防止模型复述整段手册。
# 思考型模型会把推理算进输出长度，1200 会被推理吃光导致正文为空，建议 4000
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
# 请求流式用量统计（stream_options.include_usage）；服务端不认时自动退回按字数估算
LLM_INCLUDE_USAGE=true
# 厂商特有字段（JSON 字符串），原样并入请求体。例：DeepSeek 关思考模式
#   LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
LLM_EXTRA_BODY=

# 问答默认检索参数与单个片段的上下文字符上限。
# 上限要能覆盖库里最长的块（故障码表可达 2900+ 字），设小了等于把表格腰斩
CHAT_MODE=hybrid
CHAT_TOP_K=5
CONTEXT_MAX_CHARS=3000
# 长表格按行拆块（每块复制表头）。0=不拆（默认）。
# 实测拆完更差：块数 203→274、块级 Recall@5 0.979→0.896，原因见 docs/DESIGN.md。
# 想复现那组对照就设成 1200，重新入库并跑 run_eval。
TABLE_SPLIT_CHARS=0

# ---------------- Web 与部署（P5） ----------------
# 上传落盘目录，入库也扫这里
RAW_DIR=data/raw
# 评测页优先读这个文件，缺失时回退到 EVAL_REPORT_DIR 下最新的 .md
EVAL_REPORT_PATH=results/report.md
EVAL_REPORT_DIR=data/eval
# 上传大小上限（MB）。改了要同步改 deploy/nginx.conf 的 client_max_body_size，
# 否则 nginx 会先返回 413，后端根本看不到请求
MAX_UPLOAD_MB=50
